{
  "log": {
    "access": "/var/log/xray/access.log",
    "error": "/var/log/xray/error.log",
    "loglevel": "warning",
    "dnsLog": false,
    "maskAddress": ""
  },
  "dns": {
    "servers": [
      "https+local://1.1.1.1/dns-query",
      "https+local://8.8.8.8/dns-query"
    ]
  },
  "api": {
    "tag": "api",
    "listen": "127.0.0.1:8080",
    "services": [
      "StatsService"
    ]
  },
  "inbounds": [
    {
      "tag": "Vless-XHTTP",
      "listen": "HOST-ADRESS-HERE",
      "port": 443,
      "protocol": "vless",
      "settings": {
        "decryption": "HERE-DECRYPTION-PASS",
        "clients": [
          {
            "email": "EMAIL-HERE",
            "id": "WRITE-ID-HERE",
            "flow": "xtls-rprx-vision"
          }
        ]
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "reality",
        "realitySettings": {
          "xver": 1,
          "dest": "127.0.0.1:8443",
          "privateKey": "PRIVATE-KEY-HERE",
          "serverNames": [
            "SNI-HOST.COM"
          ],
          "shortIds": [
            "SHORT-ID-HERE"
          ],
          "show": false
        },
        "xhttpSettings": {
          "path": "/WRITE-RANDOM-PATH-HERE",
          "mode": "auto"
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls",
          "quic"
        ],
        "metadataOnly": false,
        "routeOnly": true
      }
    }
  ],
  "routing": {
    "domainStrategy": "IPOnDemand",
    "rules": [
      {
        "type": "field",
        "outboundTag": "blocked",
        "domain": [
          "domain:api.ipify.org",
          "domain:ifconfig.me",
          "full:checkip.amazonaws.com"
        ]
      },
      {
        "type": "field",
        "outboundTag": "blocked",
        "ip": [
          "geoip:private",
          "geoip:ru"
        ]
      },
      {
        "type": "field",
        "outboundTag": "blocked",
        "protocol": [
          "bittorrent"
        ]
      }
    ]
  },
  "outbounds": [
    {
      "tag": "direct",
      "protocol": "freedom"
    },
    {
      "tag": "blocked",
      "protocol": "blackhole"
    }
  ],
  "stats": {},
  "policy": {
    "levels": {
      "0": {
        "statsUserDownlink": true,
        "statsUserUplink": true,
        "statsUserOnline": true
      }
    },
    "system": {
      "statsInboundDownlink": true,
      "statsInboundUplink": true,
      "statsOutboundDownlink": true,
      "statsOutboundUplink": true
    }
  }
}
